# GEMINI_API_KEY: Required for Gemini AI video understanding, highlight detection,
# facecam/gameplay region analysis, transcription, and multilingual captions.
# Obtain at: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (injected automatically in AI Studio).
APP_URL="http://localhost:3000"

# PORT: Express + Vite server port (must be 3000 in AI Studio preview).
PORT="3000"

# JWT_SECRET: Secret key used to sign user authentication JWT tokens.
# Generate a random 32+ character string for production deployments.
JWT_SECRET="clipforge_change_this_to_a_secure_random_secret_in_production"

# STORAGE_DIR: Local filesystem directory for uploaded source videos and rendered MP4 clips.
STORAGE_DIR="./storage"

# MAX_UPLOAD_MB: Maximum video upload size in megabytes (default 500 MB).
MAX_UPLOAD_MB="500"

# YOUTUBE_DATA_API_KEY: Optional Google Cloud YouTube Data API v3 key for enriched
# channel/video metadata lookup (oEmbed works without a key).
# Obtain at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_DATA_API_KEY=""
